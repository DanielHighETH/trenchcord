# ============================================================
# Trenchcord Backend (.env)
# Deploy on: VPS
# ============================================================
# LOCAL MODE: No .env needed, just "npm run dev".
# HOSTED MODE: Copy to .env and fill in values.
# ============================================================

# "local" = self-hosted single user (no config needed)
# "hosted" = multi-user web app with Supabase
TRENCHCORD_MODE=local

# Server port (defaults to 3001)
# PORT=3001

# Which address to listen on. Local mode binds 127.0.0.1 (this machine only),
# because its settings export contains your Discord tokens and Telegram sessions
# in plaintext -- on shared or public Wi-Fi, anything else would put them on the
# network. The API also requires a token (data/local-token), issued to the page
# automatically when you open Trenchcord on this machine.
# Set this only to reach Trenchcord from your own phone/PC on a network you
# trust, never on public Wi-Fi. The startup log prints the URL (with the token)
# to open on the other device.
# TRENCHCORD_HOST=0.0.0.0

# Hostnames allowed to reach the API, on top of localhost. Only needed if you
# browse to Trenchcord by name (e.g. http://nas.local:3001) rather than by IP;
# unlisted names are rejected to block DNS rebinding attacks.
# TRENCHCORD_ALLOWED_HOSTS=nas.local,my-desktop

# --- Everything below: ONLY for hosted mode ---
    
# Supabase (dashboard > Settings > API)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key

# AES-256 encryption key for Discord tokens at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOKEN_ENCRYPTION_KEY=

# CORS — your Netlify frontend URL (comma-separated if multiple)
# ALLOWED_ORIGINS=https://app.trenchcord.app
